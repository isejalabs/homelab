{
  "description": "Mink activity tracking adapted for Codex",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/scripts/mink-codex-hook.py\"",
            "statusMessage": "Mink: start session",
            "timeout": 120
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/scripts/mink-codex-hook.py\"",
            "statusMessage": "Mink: check file reads and edits",
            "timeout": 120
          }
        ],
        "matcher": "^(Bash|apply_patch|Read|Edit|Write)$"
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/scripts/mink-codex-hook.py\"",
            "statusMessage": "Mink: record file activity",
            "timeout": 120
          }
        ],
        "matcher": "^(Bash|apply_patch|Read|Edit|Write)$"
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/scripts/mink-codex-hook.py\"",
            "statusMessage": "Mink: summarize session activity",
            "timeout": 120
          }
        ]
      }
    ]
  }
}
