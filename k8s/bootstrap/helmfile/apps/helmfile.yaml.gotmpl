---
# yaml-language-server: $schema=https://json.schemastore.org/helmfile

# Bootstraps core applications that provide a minimal runtime base for the
# cluster. These releases are installed first so the cluster has the resources
# Flux needs before its own reconciliation begins.
#
# After this bootstrap phase, Flux is ready to take over management of the
# application stack and continue reconciling downstream state.

bases:
  - ../base/environments.yaml
  - ../base/helmDefaults.yaml
  - ../base/kubeContext.yaml.gotmpl
  - ../base/release-templates.yaml

defaultInherit:
  # get chart url and version from OCI release
  - chart-version-from-ocirelease
  # get chart values from HelmRelease
  - values-from-helmrelease

releases:
  - name: cilium
    namespace: kube-system
    labels:
      # Selects the subset of releases exercised by bootstrap-apps-test.yml against an ephemeral kind
      # cluster - excludes onepassword-connect (can't reach Ready without real 1Password credentials) and
      # flux-instance (its values hardcode the real GitRepository sync target, see #1209).
      ci: "true"
    {{ if ne .Environment.Name "ci" }}
    hooks:
      # Wait for CRDs to be available
      - command: kubectl
        args:
          - wait
          - --for=create
          - crd/ciliumbgpadvertisements.cilium.io
          - crd/ciliumbgpclusterconfigs.cilium.io
          - crd/ciliumbgppeerconfigs.cilium.io
          - crd/ciliumloadbalancerippools.cilium.io
          - --timeout=2m
          - --context
          - "{{ printf "admin@%s-homelab" .Environment.Name }}" # non-DRY duplicate kubeContext :-/
        events:
          - postsync
        showlogs: true
    {{ end }}
    {{ if eq .Environment.Name "ci" }}
    # bootstrap-apps-test.yml's kind cluster pulls chart images over the runner's network and has no
    # pre-warmed cache, so give it more headroom than the 5m Helm default before --wait gives up.
    timeout: 600
    {{ end }}
    inherit:
      # do not inherit values from HelmRelease...
      - template: values-from-helmrelease
        except:
          - values
      # get them from values.yaml file instead
      - template: values-from-values-yaml-file
    values:
      # CI's kind cluster isn't Talos and doesn't run the homelab's BGP/egress-gateway/Gateway API setup -
      # override those bits only for bootstrap-apps-test.yml, layered on top of the inherited values above.
      {{ if eq .Environment.Name "ci" }}
      - ../ci/cilium-values.yaml
      {{ end }}

  - name: sealed-secrets
    namespace: sealed-secrets
    labels:
      ci: "true"
    needs:
      - kube-system/cilium

  - name: external-secrets
    namespace: external-secrets
    labels:
      ci: "true"
    needs:
      - kube-system/cilium

  - name: onepassword-connect
    namespace: external-secrets
    hooks:
      - # Wait for CRDs to be available
        command: kubectl
        args:
          - wait
          - --for=create
          - crd/clustersecretstores.external-secrets.io
          - --timeout=2m
          - --context
          - "{{ printf "admin@%s-homelab" .Environment.Name }}" # non-DRY duplicate kubeContext :-/
        events:
          - postsync
        showlogs: true
      - # Apply Resources
        command: kubectl
        args:
          - apply
          - --server-side
          - --force-conflicts
          - --filename=../../../infra/{{`{{ .Release.Namespace }}`}}/{{`{{ .Release.Name }}`}}/base/clustersecretstore.yaml
          - --context
          - "{{ printf "admin@%s-homelab" .Environment.Name }}" # non-DRY duplicate kubeContext :-/
        events:
          - postsync
        showlogs: true
    needs:
      - external-secrets/external-secrets

  - name: cert-manager
    namespace: cert-manager
    labels:
      ci: "true"
    needs:
      - sealed-secrets/sealed-secrets

  - name: flux-operator
    namespace: flux-system
    labels:
      ci: "true"
    needs:
      - cert-manager/cert-manager

  - name: flux-instance
    namespace: flux-system
    needs:
      - flux-system/flux-operator
  