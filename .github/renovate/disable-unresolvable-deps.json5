{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  packageRules: [
    {
      description: "1Password's CLI (`1password-cli`/`op` in .mise.toml, both aliases of the same jdx/mise registry entry -- see registry/1password.toml) is closed-source with no public GitHub repo. mise's registry backs it with `aqua:1password/cli`, which Renovate's mise manager generically maps to a github-tags lookup on that same owner/repo -- a reasonable heuristic for most aqua-registry packages, but wrong here since 1password/cli isn't a real public repo (confirmed live, 404). No automatable public datasource exists for it; version stays a manual bump. Renaming the .mise.toml key doesn't help, since both names are plain aliases of the identical registry entry.",
      matchPackageNames: ["1password/cli"],
      enabled: false,
    },
  ],
}
