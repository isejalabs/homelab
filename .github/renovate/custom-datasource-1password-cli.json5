{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  // 1Password's CLI (`1password-cli` in .mise.toml) is closed-source with no
  // public GitHub repo -- mise's own registry backs it with
  // `aqua:1password/cli`, which the built-in `mise` manager maps to a
  // `github-tags` lookup on that owner/repo, which 404s (confirmed live).
  // Renovate has no built-in datasource for this, so this defines a custom
  // one against 1Password's own public release-notes page instead, which
  // does list every release -- confirmed live via a local `renovate
  // --platform=local --dry-run=lookup` run against this exact config
  // (correctly detected an update from a pinned old version up to the real
  // current release).
  customDatasources: {
    "1password-cli": {
      defaultRegistryUrlTemplate: "https://releases.1password.com/developers/cli/",
      format: "html",
    },
  },
  // Each release is a same-page anchor like `href=#1password-cli-2.39.0` --
  // Renovate's html datasource format extracts every <a href> value as a
  // release candidate, then extractVersion (below) picks the version back
  // out of that anchor string.
  customManagers: [
    {
      customType: "regex",
      managerFilePatterns: ["/(^|/)\\.mise\\.toml$/"],
      matchStrings: [
        '"1password-cli"\\s*=\\s*"(?<currentValue>[^"]+)"',
      ],
      depNameTemplate: "1password/cli",
      datasourceTemplate: "custom.1password-cli",
      versioningTemplate: "semver",
    },
  ],
  packageRules: [
    {
      matchDatasources: ["custom.1password-cli"],
      extractVersion: "#1password-cli-(?<version>\\d+\\.\\d+\\.\\d+)",
    },
    // The built-in `mise` manager also independently detects this same
    // `.mise.toml` entry via its own (broken) datasource -- without this,
    // it'd keep erroring alongside the working custom manager above rather
    // than being superseded by it.
    {
      matchManagers: ["mise"],
      matchDepNames: ["1password-cli"],
      enabled: false,
    },
  ],
}
