{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  // 1Password's CLI (`aqua:1password/cli` in .mise.toml) is closed-source with
  // no public GitHub repo, but the built-in `mise` manager maps every `aqua:`
  // tool to a `github-tags` lookup on that owner/repo, which 404s (confirmed
  // live). Renovate has no built-in datasource for the CLI, so this defines a
  // custom one against 1Password's own public release-notes page, which does
  // list every release, and points the built-in manager at it (rule below).
  //
  // The built-in manager is kept (rather than a custom regex manager) on
  // purpose: only it runs `mise lock <tool>` after a bump, so the PR carries
  // the matching `mise.lock` entry, and the `aqua:` backend lets `mise lock`
  // hash the downloaded zip itself. The default `vfox` backend of the
  // `1password-cli` registry name records a URL without a checksum, which
  // `mise install --locked` rejects on a cold cache.
  customDatasources: {
    "1password-cli": {
      defaultRegistryUrlTemplate: "https://releases.1password.com/developers/cli/",
      format: "html",
    },
  },
  // Each release is a same-page anchor like `href=#1password-cli-2.39.0` --
  // Renovate's html datasource format extracts every <a href> value as a
  // release candidate, then extractVersion picks the version back out of that
  // anchor string.
  packageRules: [
    {
      matchManagers: ["mise"],
      matchDepNames: ["aqua:1password/cli"],
      overrideDatasource: "custom.1password-cli",
      extractVersion: "#1password-cli-(?<version>\\d+\\.\\d+\\.\\d+)",
    },
  ],
}
