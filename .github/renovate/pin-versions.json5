{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  packageRules: [
    {
      description: 'keep cilium at an older version due to checkmk',
      allowedVersions: '<=1.19',
      matchPackageNames: [
        'quay.io/cilium/charts/cilium',
      ],
    },
    {
      description: 'allow latest versions of cilium for HEAD and PoC environment, i.e. like "latest" updates',
      allowedVersions: '>=1.19',
      matchPackageNames: [
        'quay.io/cilium/charts/cilium',
      ],
      matchFileNames: [
        'k8s/**/envs/head/**',
        'k8s/**/envs/poc/**',
        'terragrunt/**/head/**',
        'terragrunt/**/poc/**',
      ],
      "addLabels": [
        "updateStrategy:pinWatch"
      ],
    },
    {
      description: 'keep gateway-api at an older version due to cilium compatibility',
      allowedVersions: '<=1.4',
      matchPackageNames: [
        'kubernetes-sigs/gateway-api',
      ],
    },
    {
      description: 'allow latest versions of gateway-api for HEAD and PoC environment, i.e. like "latest" updates',
      allowedVersions: '>=1.4',
      matchPackageNames: [
        'kubernetes-sigs/gateway-api',
      ],
      matchFileNames: [
        'k8s/**/envs/head/**',
        'k8s/**/envs/poc/**',
        'terragrunt/**/head/**',
        'terragrunt/**/poc/**',
      ],
      "addLabels": [
        "updateStrategy:pinWatch"
      ],
    },
    {
      description: 'keep kubernetes at an older version due to checkmk',
      allowedVersions: '<=1.35',
      matchPackageNames: [
        'kubernetes/kubernetes',
      ],
    },
    {
      description: 'allow latest versions of kubernetes for HEAD and PoC environment, i.e. like "latest" updates',
      allowedVersions: '>=1.35',
      matchPackageNames: [
        'kubernetes/kubernetes',
      ],
      matchFileNames: [
        'k8s/**/envs/head/**',
        'k8s/**/envs/poc/**',
        'terragrunt/**/head/**',
        'terragrunt/**/poc/**',
      ],
      "addLabels": [
        "updateStrategy:pinWatch"
      ],
    },
    {
      description: 'keep mongodb at v8.0 due to unifi-network-controller, and for omitting minor updates with (unnecessary) changes',
      allowedVersions: '<=8.0',
      matchPackageNames: [
        'docker.io/mongo',
      ],
    },
    {
      description: 'allow latest versions of mongodb for HEAD and PoC environment, i.e. like "latest" updates',
      allowedVersions: '>=8.0',
      matchPackageNames: [
        'docker.io/mongo',
      ],
      matchFileNames: [
        'k8s/**/envs/head/**',
        'k8s/**/envs/poc/**',
        'terragrunt/**/head/**',
        'terragrunt/**/poc/**',
      ],
      "addLabels": [
        "updateStrategy:pinWatch"
      ],
    },
    {
      description: 'keep sops below 3.13.3 -- that release\'s aqua-registry entry is missing SLSA signer_identity/signer_issuer metadata, breaking `mise install --locked` in every CI workflow (#1462); no environment carve-out, this is a CI tool, not a per-environment deployment. Remove once #1464 is resolved -- #1462 itself is closed (the CI breakage is fixed), so this pin has no other expiry trigger',
      allowedVersions: '<3.13.3',
      matchPackageNames: [
        'getsops/sops',
      ],
    },
    {
      description: 'keep the Mermaid CLI at 11.12.0 -- 11.17.1 pulls chromium-bidi@157.0.8090-0, which mise\'s npm backend rejects (trustPolicy=no-downgrade: no trust evidence, while an earlier release had a trusted publisher), so docs-mermaid-check cannot install the CLI at all (#2070). No environment carve-out, this is a CI tool. Remove together with the pin in docs/.mise.toml once upstream publishes with provenance again or an owner-reviewed trust_policy_excludes entry exists',
      allowedVersions: '<=11.12.0',
      matchPackageNames: [
        '@mermaid-js/mermaid-cli',
        'npm:@mermaid-js/mermaid-cli',
      ],
    },
  ],
}
