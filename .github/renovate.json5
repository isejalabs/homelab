{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    ":disableRateLimiting",
    "config:best-practices",
    "github>isejalabs/homelab//.github/renovate/automerge-enable.json5",
    "github>isejalabs/homelab//.github/renovate/automerge-disable.json5",
    "github>isejalabs/homelab//.github/renovate/labels.json5",
    "github>isejalabs/homelab//.github/renovate/major-test-plan.json5",
    "github>isejalabs/homelab//.github/renovate/organize-semantic-scope.json5",
    "github>isejalabs/homelab//.github/renovate/pin-versions.json5",
    "github>isejalabs/homelab//.github/renovate/renames.json5",
    "github>isejalabs/homelab//.github/renovate/schedule.json5",
    "github>isejalabs/homelab//.github/renovate/version-scheme.json5",
  ],
  rebaseWhen: 'conflicted',
  // "**/charts/**": several apps (cilium, sealed-secrets, prometheus-stack,
  // grafana-cloud, metrics-server) vendor a specific chart release's own
  // rendered values.yaml under envs/<env>/charts/<name>-<version>/ -- those
  // files' own embedded image/dependency references are third-party chart
  // internals, not something to Renovate-track (confirmed live: without
  // this, the customManagers entry below would match 30+ files across
  // those vendored trees).
  ignorePaths: ["_attic/**", "**/charts/**"],
  terragrunt: {
    versioning: "regex:^((?<compatibility>.*)-v|v*)(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)$",
  },
  additionalBranchPrefix: "{{packageFileDir}}/",
  prBodyColumns: ["Package", "Package file", "Update", "Change"],
  separateMinorPatch: true,
  flux: {
    managerFilePatterns: ["/(^|/)k8s/.+\\.yaml$/"],
  },
  kubernetes: {
    managerFilePatterns: ["/(^|/)k8s/.+\\.yaml$/"],
  },
  customManagers: [
    {
      customType: "regex",
      managerFilePatterns: [
        "/\\.hcl$/",
        "/\\.tf$/",
        "/\\.tftpl$/",
        "/\\.yaml$/",
        "/\\.sh$/",
      ],
      matchStrings: [
        "(?<currentValue>[\\w+\\.\\-]*)['\",;]*\\s*#\\s?renovate: (?<datasource>\\S+)=(?<depName>\\S+)\\s?(registry=(?<registryUrl>\\S+))?\\s?(versioning=(?<versioning>\\S+))?",
      ],
    },
    {
      customType: "regex",
      managerFilePatterns: ["/(^|/)kustomization\\.ya?ml$/"],
      matchStrings: [
        "https://github\\.com/(?<depName>.*/.*?)/releases/download/(?<currentValue>.*?)/",
      ],
      datasourceTemplate: "github-releases",
    },
    {
      customType: "regex",
      managerFilePatterns: ["/(^|/)kustomization\\.ya?ml$/"],
      matchStrings: [
        "https://raw\\.githubusercontent\\.com/(?<depName>[^/]*/[^/]*)/(?<currentValue>.*?)/",
      ],
      datasourceTemplate: "github-tags",
    },
    {
      // bjw-s-labs/app-template (and any other chart following its own
      // convention) requires `image:` as an object -- {repository, tag} --
      // never a single "repo:tag" string, so it never matches the built-in
      // kubernetes manager's line-based image: regex. Confirmed neither
      // datasource picks this up before adding this (see
      // k8s/apps/dns/powerdns/base/helmrelease.yaml's own image block).
      // Vendored chart trees (see ignorePaths above) are excluded there,
      // not here -- Renovate's managerFilePatterns regex is RE2, which
      // doesn't support the negative-lookahead needed to exclude them
      // directly in this pattern (confirmed live: "Failed to parse regex
      // pattern").
      customType: "regex",
      managerFilePatterns: ["/(^|/)k8s/.+\\.yaml$/"],
      matchStrings: [
        "repository:\\s*(?<depName>\\S+)\\s+tag:\\s*[\"']?(?<currentValue>[\\w.\\-]+)(?:@(?<currentDigest>sha256:[a-f0-9]+))?[\"']?",
      ],
      datasourceTemplate: "docker",
    },
  ],
  commitMessageAction: "{{{updateType}}}",
  addLabels: [
    "pr-type:renovate"
  ],
}
